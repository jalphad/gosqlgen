{{- range .Joins }}
// {{ .JoinMethodName }} performs a type-safe inner join with {{ .ReferencedTableName }}
func (q *{{ $.BuilderName }}) {{ .JoinMethodName }}() *{{ $.BuilderName }} {
	q.joins = append(q.joins, JoinClause{
		Type:       InnerJoin,
		Table:      "{{ .ReferencedTableName }}",
		LeftField:  {{ $.BaseName }}Table.{{ .LeftFieldName }}(),
		RightField: {{ .ReferencedBaseName }}Table.{{ .RightFieldName }}(),
	})
	q.activeJoins["{{ .ReferencedTableName }}"] = true
	return q
}

// {{ .LeftJoinMethodName }} performs a type-safe left join with {{ .ReferencedTableName }}
func (q *{{ $.BuilderName }}) {{ .LeftJoinMethodName }}() *{{ $.BuilderName }} {
	q.joins = append(q.joins, JoinClause{
		Type:       LeftJoin,
		Table:      "{{ .ReferencedTableName }}",
		LeftField:  {{ $.BaseName }}Table.{{ .LeftFieldName }}(),
		RightField: {{ .ReferencedBaseName }}Table.{{ .RightFieldName }}(),
	})
	q.activeJoins["{{ .ReferencedTableName }}"] = true
	return q
}

{{- end }}

// JoinOn performs a custom join with type-safe field references
func (q *{{ .BuilderName }}) JoinOn(joinType JoinType, table string, leftField, rightField *FieldRef) *{{ .BuilderName }} {
	q.joins = append(q.joins, JoinClause{
		Type:       joinType,
		Table:      table,
		LeftField:  leftField,
		RightField: rightField,
	})
	return q
}
