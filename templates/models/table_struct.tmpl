)

type {{ .StructName }}s []*{{ .StructName }}

{{ range .Fields }}
func ({{ $.ReceiverName }} {{ $.StructName }}s) {{ .FieldName }}() ast.OfType[[]{{ baseType .GoType }}] {
	out := make([]{{ if .IsPointer }}*{{ end }}{{ baseType .GoType }}, len({{ $.ReceiverName }}))
	for idx, dto := range {{ $.ReceiverName }} {
		out[idx] = dto.{{ .FieldName }}
	}
	{{- if .IsPointer }}
	return ast.SetType[[]{{ baseType .GoType }}](ast.NewLiteralExpression(out))
	{{- else }}
	return ast.NewSQLType(out)
	{{- end }}
}
{{ end }}

func ({{ .ReceiverName }} {{ .StructName }}s) GetValues(columns ...ast.NamedExpression) []ast.Expression {
	im := make([]ast.Expression, 0, len({{ .ReceiverName }})*len(columns))
	for _, column := range columns {
		columnLower := strings.ToLower(column.Name())

		{{- range .Fields }}
		{{ template "ifColumnLower" . }}
			for _, dto := range {{ $.ReceiverName }} {
				im = append(im, ast.NewLiteralExpression(dto.{{ .FieldName }}))
			}
		}
		{{- end }}
	}

	values := make([]ast.Expression, 0, len({{ .ReceiverName }}))
	for i := 0; i < len({{ .ReceiverName }}); i++ {
		grouped := make([]ast.Expression, len(columns))
		for j := range columns {
			grouped[j] = im[j*len({{ .ReceiverName }})+i]
		}

		values = append(values, ast.NewGroupedExpression(grouped...))
	}

	return values
}

// {{ .StructName }} represents the {{ .TableName }} table
type {{ .StructName }} struct {
{{- range .Fields }}
	{{ .FieldName }} {{ .GoType }} {{ .StructTags }}
{{- end }}
{{- if .JoinedFields }}

	// Joined relationships (populated when corresponding Join method is called)
{{- range .JoinedFields }}
	{{ .FieldName }} {{ .GoType }} `joined:"{{ .ReferencedTable }}" fk:"{{ .FKColumn }}"`
{{- end }}
{{- end }}
{{- if .ReverseRelFields }}

	// One-to-many reverse relationships (populated via LoadXxx methods)
{{- range .ReverseRelFields }}
	{{ .FieldName }} {{ .GoType }} `reverse:"{{ .FromTable }}" fk:"{{ .FKColumn }}"`
{{- end }}
{{- end }}
{{- if .ManyToManyFields }}

	// Many-to-many relationships (populated via LoadXxx methods)
{{- range .ManyToManyFields }}
	{{ .FieldName }} {{ .GoType }} `manytomany:"{{ .JunctionTable }}"`
{{- end }}
{{- end }}
}

// TableName returns the table name for {{ .StructName }}
func ({{ .ReceiverName }} *{{ .StructName }}) TableName() string {
	return "{{ .TableName }}"
}

{{- if needsCustomUnmarshal .Fields }}
func ({{ .ReceiverName }} *{{ .StructName }}) UnmarshalJSON(b []byte) error {
	type {{ .StructName }}_ {{ .StructName }}
	type DtoWrapper struct {
		{{ .StructName }}_
		{{- range .Fields }}
		{{- if (hasSuffix .GoType "time.Time") }}
		{{- if eq .SQLType "DATE" }}
		{{ .FieldName }} DateWrapper {{ .StructTags }}
		{{- else if or (eq .SQLType "TIME") (eq .SQLType "TIME WITHOUT TIME ZONE") }}
		{{ .FieldName }} TimeWrapper {{ .StructTags }}
		{{- else if eq .SQLType "TIME WITH TIME ZONE" }}
		{{ .FieldName }} TimeWithTZWrapper {{ .StructTags }}
		{{- else if or (eq .SQLType "TIMESTAMP") (eq .SQLType "TIMESTAMP WITHOUT TIME ZONE") (eq .SQLType "TIMESTAMP WITH TIME ZONE") }}
		{{ .FieldName }} NoTimezoneWrapper {{ .StructTags }}
		{{- end }}
		{{- end }}
		{{- end }}
	}

	var wrapper DtoWrapper
	err := json.Unmarshal(b, &wrapper)
	if err != nil {
		return err
	}

	*{{ .ReceiverName }} = {{ .StructName }}(wrapper.{{ .StructName }}_)
	{{- range .Fields }}
	{{- if (hasSuffix .GoType "time.Time") }}
	{{- if or (eq .SQLType "DATE") (eq .SQLType "TIME") (eq .SQLType "TIMESTAMP") (eq .SQLType "TIME WITH TIME ZONE") (eq .SQLType "TIME WITHOUT TIME ZONE") (eq .SQLType "TIMESTAMP WITHOUT TIME ZONE") (eq .SQLType "TIMESTAMP WITH TIME ZONE") }}
	{{ $.ReceiverName }}.{{ .FieldName }} = {{ if isPtr .GoType }}&{{ end }}wrapper.{{ .FieldName }}.Time
	{{- end }}
	{{- end }}
	{{- end }}

	return nil
}
{{- end }}

