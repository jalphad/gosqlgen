package {{ .TableName }}

import (
	{{- if usesType .Fields "json.RawMessage" }}
	"encoding/json"
	{{- end }}
	"fmt"
	"slices"
	{{- if usesType .Fields "time.Time" }}
	"time"
	{{- end }}

	{{- if usesType .Fields "uuid.UUID" }}
	"github.com/google/uuid"
	{{- end }}
	{{- if usesType .Fields "pgtype.Numeric" }}
	"github.com/jackc/pgx/v5/pgtype"
	{{- end }}
	"github.com/jackc/pgx/v5/pgxpool"

	"{{ .PackagePath }}/models"
	"{{ .PackagePath }}/query/ast"
	"{{ .PackagePath }}/query/builder"
	{{- if or .ReverseRelFields .ManyToManyFields }}
	"{{ .PackagePath }}/query/expr"
	{{- end }}
)

// NewQuery returns a query builder for {{ .TableName }}
func NewQuery(pool *pgxpool.Pool) *builder.KnownTableBuilder[models.{{ .StructName }}] {
	return builder.NewKnownTableBuilder[models.{{ .StructName }}](pool, Table())
}

var Into = into{{ .StructName }}{}

type into{{ .StructName }} struct{}

func Table() *ast.TableSource {
	return ast.NewTableSource("{{ .TableName }}")
}

{{ range .Fields }}
func {{ .FieldName }}() *ast.{{ toProjectionType .GoType .SQLType }}[models.{{ $.StructName }}, {{ scanDestType .GoType }}] {
	return new{{ .FieldName }}("{{ $.TableName }}", func({{ $.ReceiverName }} *models.{{ $.StructName }}) {{ scanDestType .GoType }} {
		return &{{ $.ReceiverName }}.{{ .FieldName }}
	})
}
{{ end }}

func AllColumns() []ast.NamedExpression {
	return []ast.NamedExpression{
	{{- range .Fields }}
		{{ .FieldName }}(),
	{{- end }}
	}
}

{{ range .Fields }}
func (into{{ $.StructName }}) {{ .FieldName }}() ast.Projection[models.{{ $.StructName }}] {
	return {{ .FieldName }}()
}
{{ end }}

func (into{{ .StructName }}) AllColumns() []ast.Projection[models.{{ .StructName }}] {
	return []ast.Projection[models.{{ .StructName }}]{
	{{- range .Fields }}
		Into.{{ .FieldName }}(),
	{{- end }}
	}
}

type for{{ .StructName }}[T any] struct {
	dest func(*T) *models.{{ .StructName }}
}

func For[T any](dest func(*T) *models.{{ .StructName }}) for{{ .StructName }}[T] {
	return for{{ .StructName }}[T]{dest: dest}
}

{{ range .Fields }}
func (f for{{ $.StructName }}[T]) {{ .FieldName }}() *ast.{{ toProjectionType .GoType .SQLType }}[T, {{ scanDestType .GoType }}] {
	return new{{ .FieldName }}("{{ $.TableName }}", func(t *T) {{ scanDestType .GoType }} {
		dto := f.dest(t)
		return &dto.{{ .FieldName }}
	})
}
{{ end }}

func (f for{{ .StructName }}[T]) AllColumns() []ast.Projection[T] {
	return []ast.Projection[T]{
	{{- range .Fields }}
		f.{{ .FieldName }}(),
	{{- end }}
	}
}

{{ range .ReverseRelFields }}
{{- $rel := . }}
func (into{{ $.StructName }}) {{ .FieldName }}(columns ...ast.NamedExpression) ast.Projection[models.{{ $.StructName }}] {
	if len(columns) == 0 {
		columns = default{{ .FieldName }}Columns()
	}
	{{- $filter := filterColumn .FromColumns .FromPKField .FKColumn }}
	return ast.NewJSONProjection(
		expr.JsonAggObject("{{ .FieldName | toLower }}", expr.IsNotNull(ast.New{{ toTypeExpression $filter.GoType $filter.SQLType }}("{{ .FromTable }}", "{{ $filter.ColumnName }}")), columns...),
		func({{ $.ReceiverName }} *models.{{ $.StructName }}) *{{ modelType .GoType }} {
			return &{{ $.ReceiverName }}.{{ .FieldName }}
		},
	)
}

func default{{ .FieldName }}Columns() []ast.NamedExpression {
	return []ast.NamedExpression{
	{{- range .FromColumns }}
		ast.New{{ toTypeExpression .GoType .SQLType }}("{{ $rel.FromTable }}", "{{ .ColumnName }}"),
	{{- end }}
	}
}
{{ end }}

{{ range .ReverseRelFields }}
{{- $rel := . }}
func (f for{{ $.StructName }}[T]) {{ .FieldName }}(columns ...ast.NamedExpression) ast.Projection[T] {
	if len(columns) == 0 {
		columns = default{{ .FieldName }}Columns()
	}
	{{- $filter := filterColumn .FromColumns .FromPKField .FKColumn }}
	return ast.NewJSONProjection(
		expr.JsonAggObject("{{ .FieldName | toLower }}", expr.IsNotNull(ast.New{{ toTypeExpression $filter.GoType $filter.SQLType }}("{{ .FromTable }}", "{{ $filter.ColumnName }}")), columns...),
		func(t *T) *{{ modelType .GoType }} {
			dto := f.dest(t)
			return &dto.{{ .FieldName }}
		},
	)
}
{{ end }}

{{ range .ManyToManyFields }}
{{- $rel := . }}
func (into{{ $.StructName }}) {{ .FieldName }}(columns ...ast.NamedExpression) ast.Projection[models.{{ $.StructName }}] {
	if len(columns) == 0 {
		columns = default{{ .FieldName }}Columns()
	}
	{{- $filter := filterColumn .ReferencedColumns .ReferencedPKField .RightFKColumn }}
	return ast.NewJSONProjection(
