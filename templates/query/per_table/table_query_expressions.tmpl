)

// NewQuery returns a query builder for {{ .TableName }}
func NewQuery(pool *pgxpool.Pool) *builder.KnownTableBuilder[models.{{ .StructName }}] {
	return builder.NewKnownTableBuilder[models.{{ .StructName }}](pool, Table())
}

var Into = into{{ .StructName }}{}

type into{{ .StructName }} struct{}

type for{{ .StructName }}[E models.Exports{{ .StructName }}[T], T any] struct {
	alias *Alias
	err   error
}

// TODO(go1.27): if type parameters on methods are available, consider
// supporting alias.For[*resultRow]() as the primary alias API.
func For[E models.Exports{{ .StructName }}[T], T any](alias ...*Alias) for{{ .StructName }}[E, T] {
	switch len(alias) {
	case 0:
		return for{{ .StructName }}[E, T]{}
	case 1:
		if alias[0] == nil || alias[0].Alias == nil {
			return for{{ .StructName }}[E, T]{err: fmt.Errorf("{{ .TableName }}.For requires a non-nil alias")}
		}
		return for{{ .StructName }}[E, T]{alias: alias[0]}
	default:
		return for{{ .StructName }}[E, T]{err: fmt.Errorf("{{ .TableName }}.For accepts at most one alias")}
	}
}

func Table() *ast.TableSource {
	return ast.NewTableSource("{{ .TableName }}")
}

{{ range .Fields }}
func {{ .FieldName }}() *ast.{{ toProjectionType .GoType .SQLType }}[models.{{ $.StructName }}, {{ scanDestType .GoType }}] {
	return ast.New{{ toProjectionType .GoType .SQLType }}(
		"{{ $.TableName }}",
		"{{ .ColumnName }}",
		func({{ $.ReceiverName }} *models.{{ $.StructName }}) {{ scanDestType .GoType }} {
			return &{{ $.ReceiverName }}.{{ .FieldName }}
		},
	)
}
{{ end }}

func AllColumns() []ast.NamedExpression {
	return []ast.NamedExpression{
	{{- range .Fields }}
		{{ .FieldName }}(),
	{{- end }}
	}
}

{{ range .Fields }}
func (into{{ $.StructName }}) {{ .FieldName }}() ast.Projection[models.{{ $.StructName }}] {
	return {{ .FieldName }}()
}
{{ end }}

func (into{{ .StructName }}) AllColumns() []ast.Projection[models.{{ .StructName }}] {
	return []ast.Projection[models.{{ .StructName }}]{
	{{- range .Fields }}
		Into.{{ .FieldName }}(),
	{{- end }}
	}
}

{{ range .Fields }}
func (f for{{ $.StructName }}[E, T]) {{ .FieldName }}() *ast.{{ toProjectionType .GoType .SQLType }}[T, {{ scanDestType .GoType }}] {
	column := {{ .FieldName }}()
	projection := ast.New{{ toProjectionType .GoType .SQLType }}[T, {{ scanDestType .GoType }}](
		f.tableName(),
		column.Name(),
		func(t *T) {{ scanDestType .GoType }} {
			e := E(t)
			dto := e.Get{{ $.StructName }}()
			return &dto.{{ .FieldName }}
		},
	)
	if f.err != nil {
		errExpr := ast.NewErrorExpression(f.err)
		projection.{{ toTypeExpression .GoType .SQLType }} = ast.New{{ toTypeExpression .GoType .SQLType }}FromExpr(column.Name(), errExpr)
		return projection
	}
	if f.alias == nil || slices.ContainsFunc(f.alias.Columns(), func(e ast.NamedExpression) bool {
		return e.Name() == column.Name()
	}) {
		return projection
	}
	errExpr := ast.NewErrorExpression(fmt.Errorf("unknown column '{{ .ColumnName }}' in alias %s", f.alias.Alias.Name()))
	projection.{{ toTypeExpression .GoType .SQLType }} = ast.New{{ toTypeExpression .GoType .SQLType }}FromExpr(column.Name(), errExpr)
	return projection
}
{{ end }}

func (f for{{ .StructName }}[E, T]) tableName() string {
	if f.alias == nil || f.alias.Alias == nil {
		return "{{ .TableName }}"
	}
	return f.alias.Alias.Name()
}

func (f for{{ .StructName }}[E, T]) AllColumns() []ast.Projection[T] {
	return []ast.Projection[T]{
	{{- range .Fields }}
		f.{{ .FieldName }}(),
	{{- end }}
	}
}

{{ range .ReverseRelFields }}
{{- $rel := . }}
func (into{{ $.StructName }}) {{ .FieldName }}(columns ...ast.NamedExpression) ast.Projection[models.{{ $.StructName }}] {
	if len(columns) == 0 {
		columns = default{{ .FieldName }}Columns()
	}
	{{- $filter := filterColumn .FromColumns .FromPKField .FKColumn }}
	return ast.NewJSONProjection(
		expr.JsonAggObject("{{ .FieldName | toLower }}", expr.IsNotNull(ast.New{{ toTypeExpression $filter.GoType $filter.SQLType }}("{{ .FromTable }}", "{{ $filter.ColumnName }}")), columns...),
		func({{ $.ReceiverName }} *models.{{ $.StructName }}) *{{ modelType .GoType }} {
			return &{{ $.ReceiverName }}.{{ .FieldName }}
		},
	)
}

func default{{ .FieldName }}Columns() []ast.NamedExpression {
	return []ast.NamedExpression{
	{{- range .FromColumns }}
		ast.New{{ toTypeExpression .GoType .SQLType }}("{{ $rel.FromTable }}", "{{ .ColumnName }}"),
	{{- end }}
	}
}
{{ end }}

