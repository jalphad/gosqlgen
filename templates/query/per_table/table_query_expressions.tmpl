type Alias[T any] struct {
	*ast.Alias
	for{{ $.StructName }}[T]
}

func As(name string, columns ...ast.NamedExpression) Alias[models.{{ .StructName }}] {
	return Alias[models.{{ .StructName }}]{
		Alias: ast.NewAlias(name, columns...),
		for{{ $.StructName }}: for{{ $.StructName }}[models.{{ .StructName }}]{
			dest: func({{ $.ReceiverName }} *models.{{ .StructName }}) *models.{{ .StructName }} {
				return {{ $.ReceiverName }}
			},
		},
	}
}

{{ range .Fields }}
func (a Alias[T]) {{ .FieldName }}() *ast.{{ toProjectionType .GoType .SQLType }}[T, {{ scanDestType .GoType }}] {
	projection := new{{ .FieldName }}(a.Alias.Name(), func(t *T) {{ scanDestType .GoType }} {
		dto := a.dest(t)
		return &dto.{{ .FieldName }}
	})
	if len(a.Columns()) == 0 || slices.ContainsFunc(a.Columns(), func(e ast.NamedExpression) bool {
		return e.Name() == projection.Name()
	}) {
		return projection
	}
	errExpr := ast.NewErrorExpression(fmt.Errorf("unknown column '{{ .ColumnName }}' in alias %s", a.Alias.Name()))
	projection.{{ toTypeExpression .GoType .SQLType }} = ast.New{{ toTypeExpression .GoType .SQLType }}FromExpr(projection.Name(), errExpr)
	return projection
}
{{ end }}

func (a Alias[T]) AllColumns() []ast.Projection[T] {
	return []ast.Projection[T]{
	{{- range .Fields }}
		a.{{ .FieldName }}(),
	{{- end }}
	}
}

func AliasFor[T any](alias *ast.Alias, dest func(*T) *models.{{ .StructName }}) Alias[T] {
	return Alias[T]{
		Alias: alias,
		for{{ $.StructName }}: for{{ $.StructName }}[T]{dest: dest},
	}
}

{{ range .Fields }}
func new{{ .FieldName }}[T any](table string, ref func(*T) {{ scanDestType .GoType }}) *ast.{{ toProjectionType .GoType .SQLType }}[T, {{ scanDestType .GoType }}] {
	return ast.New{{ toProjectionType .GoType .SQLType }}(
		table,
		"{{ .ColumnName }}",
		ref,
	)
}
{{ end }}
