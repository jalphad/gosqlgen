package dtos

import (
	"time"
	"strings"

	"github.com/google/uuid"
	database "{{ .DtoPackagePath }}"
	"{{ .DtoPackagePath }}/query/ast"
)
{{ with .Table }}
// {{ .StructName }}s is a collection of {{ .StructName }} DTOs used for bulk operations
type {{ .StructName }}s []*database.{{ .StructName }}
{{ $structName := .StructName }}
{{- range .Columns }}
// {{ .FieldName }} returns a slice of all {{ .FieldName }} values from the collection
func (d {{ $structName }}s) {{ .FieldName }}() ast.OfType[[]{{ .GoType }}] {
	out := make([]{{ if .IsPointer }}*{{ end }}{{ .GoType }}, len(d))
	for idx, dto := range d {
		out[idx] = dto.{{ .FieldName }}
	}
	return ast.SetType[[]{{ .GoType }}](ast.NewLiteralExpression(out))
}
{{ end }}
func (d {{ .StructName }}s) GetValues(columns ...ast.NamedExpression) []ast.Expression {
	im := make([]ast.Expression, 0, len(d)*len(columns))
	for _, column := range columns {
		// Normalize column name for matching (lowercase)
		columnLower := strings.ToLower(column.Name())
		{{ range .Columns }}
		if columnLower == "{{ .ColumnName }}" {
			for _, dto := range d {
				im = append(im, ast.NewLiteralExpression(dto.{{ .FieldName }}))
			}
		}
		{{ end }}
	}

	values := make([]ast.Expression, 0, len(d))
	for i := 0; i < len(d); i++ {
		grouped := make([]ast.Expression, len(columns))
		for j := range columns {
			grouped[j] = im[j*len(d)+i]
		}

		values = append(values, ast.NewGroupedExpression(grouped...))
	}

	return values
}

func (d {{ .StructName }}s) GetArgs(column ast.NamedExpression) ast.Expression {
	// Normalize column name for matching (lowercase)
	columnLower := strings.ToLower(column.Name())
	{{ range .Columns }}
	if columnLower == "{{ .ColumnName }}" {
		out := d.{{ .FieldName }}()
		return ast.NewLiteralExpression(out)
	}
	{{ end }}
	return ast.NewErrorExpression(errors.New("unknown column"))
}
{{ end }}