package {{ .PackageName }}

import (
	"context"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"{{ .PackagePath }}/models"
	"{{ .PackagePath }}/query/builder"
	"{{ .PackagePath }}/query/dtos"
)

// DB wraps the database connection pool
type DB struct {
	pool *pgxpool.Pool
}

// NewDB creates a new database wrapper
func NewDB(pool *pgxpool.Pool) *DB {
	return &DB{pool: pool}
}

{{- range .Tables }}

// {{ .MethodName }} returns a query builder for {{ .TableName }}
func (db *DB) {{ .MethodName }}() *builder.KnownTableBuilder[dtos.{{ .StructName }}s, models.{{ .StructName }}, *models.{{ .StructName }}] {
	return New{{ .BuilderName }}(db.pool)
}
{{- end }}

// Transaction executes a function within a transaction
func (db *DB) Transaction(ctx context.Context, fn func(*Tx) error) error {
	return pgx.BeginFunc(ctx, db.pool, func(pgxTx pgx.Tx) error {
		tx := NewTx(pgxTx)
		return fn(tx)
	})
}

// Tx provides transaction-aware query builders
type Tx struct {
	tx pgx.Tx
}

// NewTx creates transaction-aware query builders
func NewTx(tx pgx.Tx) *Tx {
	return &Tx{tx: tx}
}

{{- range .Tables }}

// {{ .MethodName }} returns a query builder within the transaction
func (tx *Tx) {{ .MethodName }}() builder.KnownTableStartQuery[dtos.{{ .StructName }}s, models.{{ .StructName }}, *models.{{ .StructName }}] {
	q := New{{ .BuilderName }}(nil)
	return q.WithTx(tx.tx)
}
{{- end }}

{{- range .Tables }}

// New{{ .BuilderName }} returns a query builder for {{ .TableName }}
func New{{ .BuilderName }}(pool *pgxpool.Pool) *builder.KnownTableBuilder[dtos.{{ .StructName }}s, models.{{ .StructName }}, *models.{{ .StructName }}] {
	return builder.NewKnownTableBuilder(dtos.{{ .StructName }}s{}, pool)
}
{{- end }}
